---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. Generate static paths for every project in the content collection
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  return projects.map((project: CollectionEntry<'projects'>) => {
    // Strip file extension to ensure clean URL slugs (e.g. /projects/my-project)
    const slug = project.id.replace(/\.[^/.]+$/, '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// Render Markdown/MDX body into the Astro Content component
const { Content } = await render(project);

// Format date nicely
const formattedDate = new Date(project.data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout 
  title={`${project.data.title} | Case Study`}
  description={project.data.description}
>
  <article class="max-w-4xl mx-auto py-8 sm:py-12 px-4 sm:px-6 lg:px-8">
    
    <!-- Navigation Back Link -->
    <a 
      href="/#projects" 
      class="inline-flex items-center gap-2 text-xs font-mono font-medium text-slate-400 hover:text-indigo-400 mb-8 transition-colors group"
    >
      <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to all projects
    </a>

    <!-- Header Section -->
    <header class="mb-10 pb-8 border-b border-slate-800/80">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          {project.data.category}
        </span>
        <span class="text-xs font-mono text-slate-400">
          Published {formattedDate}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4 leading-tight">
        {project.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
        {project.data.description}
      </p>

      <!-- Optional Project Banner Image -->
      {(project.data.heroImage || project.data.image) && (
        <div class="mt-8 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900/50">
          <img 
            src={project.data.heroImage || project.data.image} 
            alt={project.data.title}
            class="w-full h-auto max-h-[480px] object-cover"
          />
        </div>
      )}

      <!-- Tags & Action Buttons -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mt-8 pt-6 border-t border-slate-800/60">
        
        <!-- Tech Stack Tags -->
        <div class="flex flex-wrap gap-2">
          {project.data.tags.map((tag: string) => (
            <span class="text-xs font-mono text-slate-300 bg-slate-900 px-3 py-1 rounded-md border border-slate-800">
              #{tag}
            </span>
          ))}
        </div>

        <!-- External URLs -->
        <div class="flex items-center gap-3">
          {project.data.demoUrl && (
            <a 
              href={project.data.demoUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-lg shadow-indigo-500/20"
            >
              <span>Live Demo</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}

          {project.data.githubUrl && (
            <a 
              href={project.data.githubUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub Repository</span>
            </a>
          )}
        </div>

      </div>
    </header>

    <!-- Project Markdown/MDX Body Content -->
    <div class="prose prose-invert prose-slate max-w-none 
      prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4
      prose-p:text-slate-300 prose-p:leading-relaxed prose-p:mb-6
      prose-a:text-indigo-400 hover:prose-a:text-indigo-300 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-white
      prose-code:text-indigo-300 prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:border prose-code:border-slate-800 prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800 prose-pre:rounded-xl
      prose-blockquote:border-l-indigo-500 prose-blockquote:bg-slate-900/40 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-400
      prose-img:rounded-xl prose-img:border prose-img:border-slate-800">
      <Content />
    </div>

    <!-- Article Footer CTA -->
    <div class="mt-16 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a 
        href="/#projects" 
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-white transition-colors"
      >
        &larr; Back to all projects
      </a>

      <a 
        href="/#contact" 
        class="text-xs font-semibold px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-indigo-400 border border-slate-800 transition-colors"
      >
        Have questions? Get in touch &rarr;
      </a>
    </div>

  </article>
</BaseLayout>