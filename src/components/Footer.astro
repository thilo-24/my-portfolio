---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: "Projects", href: "#projects" },
  { name: "About", href: "#about" },
  { name: "Contact", href: "#contact" },
];

const socialLinks = [
  { 
    name: "GitHub", 
    href: "https://github.com/thilo-24", 
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`
  },
  { 
    name: "LinkedIn", 
    href: "https://linkedin.com", 
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>`
  }
];
---

<footer class="relative border-t border-slate-800/80 bg-slate-950 pt-16 pb-12 overflow-hidden">
  <!-- Subtle Ambient Top Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-slate-800/60">
      
      <!-- Column 1: Brand & Bio -->
      <div class="md:col-span-5 space-y-4">
        <a href="/" class="group inline-flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-indigo-600 to-cyan-400 p-[1px] shadow-md shadow-indigo-500/20">
            <div class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center font-mono font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-300 text-xs">
              &lt;/&gt;
            </div>
          </div>
          <span class="text-lg font-extrabold tracking-tight text-white group-hover:text-indigo-300 transition-colors">
            Portfolio<span class="text-indigo-500">.</span>
          </span>
        </a>

        <p class="text-xs sm:text-sm text-slate-400 max-w-sm leading-relaxed">
          Crafting high-performance digital experiences, visual design systems, and modern web applications with clean code and purpose.
        </p>

        <!-- Tech Badge Stack -->
        <div class="flex items-center gap-2 pt-2">
          <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-indigo-400">
            Astro
          </span>
          <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-cyan-400">
            React
          </span>
          <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-purple-400">
            Tailwind CSS
          </span>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">Navigation</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs text-slate-400 hover:text-indigo-400 transition-colors inline-block">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Connect & Socials -->
      <div class="md:col-span-4 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">Connect</h3>
        <p class="text-xs text-slate-400">
          Open for freelance opportunities, software engineering roles, and creative collaborations.
        </p>
        
        <div class="flex items-center gap-3 pt-1">
          {socialLinks.map((social) => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label={social.name}
              class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-indigo-500/40 hover:bg-slate-800/80 transition-all duration-200"
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom Bar: Copyright & Back to Top -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; {currentYear} Sritharan Thiloshan. All rights reserved.
      </div>

      <button 
        id="scroll-to-top" 
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-400 hover:text-white transition-all duration-200"
      >
        <span>Back to top</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </button>
    </div>

  </div>
</footer>

<script>
  const scrollBtn = document.getElementById('scroll-to-top');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>