---
const skillCategories = [
  {
    category: "Development & Frameworks",
    skills: ["Astro", "React", "TypeScript", "JavaScript", "HTML5/CSS3", "Tailwind CSS", "Node.js"]
  },
  {
    category: "Design & Media",
    skills: ["Brand Identity", "Vector Graphics", "UI/UX Design", "Layout & Typography", "Asset Production"]
  },
  {
    category: "Tools & Workflow",
    skills: ["Git & GitHub", "VS Code", "Vercel", "npm / Node Package Manager"]
  }
];
---

<section id="about" class="py-16 border-t border-slate-800/60">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    
    <!-- Left Column: Bio & Background -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <h2 class="text-3xl font-extrabold text-white tracking-tight">About Me</h2>
        <p class="text-indigo-400 font-medium text-sm mt-1">Developer & Creative Designer</p>
      </div>

      <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
        I specialize in building fast, modern web applications and crafting crisp visual brand identities. My work focuses on clean code structure, high performance, and thoughtful user interfaces.
      </p>

      <p class="text-slate-400 leading-relaxed text-sm sm:text-base">
        Whether developing performant static sites with Astro and React or executing brand systems and digital assets, I bring ideas to life with precision and focus.
      </p>

      <!-- Quick Stats / Highlights -->
      <div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-800/60">
        <div class="bg-slate-900/80 border border-slate-800 p-4 rounded-xl">
          <div class="text-2xl font-bold text-white">100%</div>
          <div class="text-xs text-slate-400 mt-0.5">Focus on Performance</div>
        </div>
        <div class="bg-slate-900/80 border border-slate-800 p-4 rounded-xl">
          <div class="text-2xl font-bold text-white">Full-Stack</div>
          <div class="text-xs text-slate-400 mt-0.5">Development & Design</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Technical Skills Grid -->
    <div class="lg:col-span-7 space-y-6">
      <h3 class="text-xl font-bold text-white mb-2">Technical Skills & Tools</h3>

      <div class="space-y-6">
        {skillCategories.map((cat) => (
          <div class="bg-slate-900/50 border border-slate-800/80 rounded-xl p-5 hover:border-slate-700/80 transition-colors">
            <h4 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-3">
              {cat.category}
            </h4>

            <div class="flex flex-wrap gap-2">
              {cat.skills.map((skill) => (
                <span class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-sm">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>