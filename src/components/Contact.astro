---
// Get your free access key at https://web3forms.com
const WEB3FORMS_ACCESS_KEY = "YOUR_ACCESS_KEY_HERE"; 
---

<section id="contact" class="py-20 border-t border-slate-800/60 relative overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono mb-3">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        Get In Touch
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Let's Build Something Together</h2>
      <p class="text-slate-400 text-sm sm:text-base mt-3 leading-relaxed">
        Have a project in mind, a position to fill, or a design concept to bring to life? Send a message and let's start a conversation.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Contact Cards -->
      <div class="lg:col-span-4 space-y-4">
        
        <!-- Direct Email Card -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-indigo-500/30 transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Email</h3>
              <p class="text-sm font-medium text-white mt-0.5">Your email address</p>
            </div>
          </div>
        </div>

        <!-- Location Card -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-indigo-500/30 transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Location</h3>
              <p class="text-sm font-medium text-white mt-0.5">Sri Lanka</p>
            </div>
          </div>
        </div>

        <!-- Response Time Card -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-indigo-500/30 transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Response Time</h3>
              <p class="text-sm font-medium text-white mt-0.5">Within 24 Hours</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-8">
        <div class="bg-slate-900/80 border border-slate-800/80 rounded-2xl p-6 sm:p-8 shadow-2xl relative">
          
          <form id="contact-form" class="space-y-6">
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="New Portfolio Contact Form Submission" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Name Field -->
              <div>
                <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Your Name <span class="text-indigo-400">*</span>
                </label>
                <input 
                  type="text" 
                  name="name" 
                  id="name" 
                  required 
                  placeholder="John Doe"
                  class="w-full bg-slate-800/60 border border-slate-700/80 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all"
                />
              </div>

              <!-- Email Field -->
              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                  Email Address <span class="text-indigo-400">*</span>
                </label>
                <input 
                  type="email" 
                  name="email" 
                  id="email" 
                  required 
                  placeholder="john@example.com"
                  class="w-full bg-slate-800/60 border border-slate-700/80 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all"
                />
              </div>
            </div>

            <!-- Subject Line -->
            <div>
              <label for="topic" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                Subject <span class="text-indigo-400">*</span>
              </label>
              <input 
                type="text" 
                name="topic" 
                id="topic" 
                required 
                placeholder="Project Inquiry / Frontend Development"
                class="w-full bg-slate-800/60 border border-slate-700/80 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all"
              />
            </div>

            <!-- Message Body -->
            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                Message <span class="text-indigo-400">*</span>
              </label>
              <textarea 
                name="message" 
                id="message" 
                rows="5" 
                required 
                placeholder="Tell me a bit about your project or inquiry..."
                class="w-full bg-slate-800/60 border border-slate-700/80 rounded-xl px-4 py-3 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div>
              <button 
                type="submit" 
                id="submit-btn"
                class="w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold text-sm rounded-xl shadow-lg shadow-indigo-500/20 transition-all duration-300 flex items-center justify-center gap-2.5 cursor-pointer hover:scale-[1.01]"
              >
                <span id="btn-text">Send Message</span>
                <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>

            <!-- Status Result Message -->
            <div id="form-result" class="hidden text-sm p-4 rounded-xl font-medium"></div>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');

  if (form && result && submitBtn && btnText) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Update Button State to Loading
      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';
      result.classList.add('hidden');

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      })
      .then(async (response) => {
        let jsonRes = await response.json();
        if (response.status == 200) {
          result.className = 'text-sm p-4 rounded-xl font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 block';
          result.innerHTML = '✓ Message sent successfully! I will get back to you shortly.';
          form.reset();
        } else {
          result.className = 'text-sm p-4 rounded-xl font-medium bg-red-500/10 border border-red-500/30 text-red-400 block';
          result.innerHTML = jsonRes.message || 'Something went wrong. Please try again.';
        }
      })
      .catch(error => {
        result.className = 'text-sm p-4 rounded-xl font-medium bg-red-500/10 border border-red-500/30 text-red-400 block';
        result.innerHTML = 'Unable to send message. Please check your internet connection.';
      })
      .then(function() {
        submitBtn.disabled = false;
        btnText.textContent = 'Send Message';
      });
    });
  }
</script>